{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    // Only this app's own @types: the repo root's node_modules sits above us
    // and must never leak into the mobile program.
    "typeRoots": ["./node_modules/@types"],
    "types": [],
    "paths": {
      // The shared item/response schemas (../src/lib/assessment) import zod;
      // resolve it from this app so type-checking never needs the root install.
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "app.config.ts", "expo-env.d.ts", "node_modules/expo/types/index.d.ts"]
}
