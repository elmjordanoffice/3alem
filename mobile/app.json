{
  "expo": {
    "name": "Aalim",
    "slug": "aalim",
    "scheme": "aalim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1B1840",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aalim.candidate",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "ar"]
      }
    },
    "android": {
      "package": "com.aalim.candidate",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1A3291",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Aalim",
      "themeColor": "#1B1840",
      "backgroundColor": "#1B1840"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#1B1840",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#1B1840" }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
