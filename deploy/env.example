# Aalim, one-server setup. Copy to deploy/.env and fill in.
# Generate secrets with: openssl rand -hex 32   (letters and digits only, so they're safe in URLs)

DOMAIN=aalim.yourcompany.com

DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
BETTER_AUTH_SECRET=
CRON_SECRET=

# Email (required for invitations and password resets)
SMTP_URL=smtps://resend:API_KEY@smtp.resend.com:465
MAIL_FROM=Aalim <hello@yourcompany.com>

# AI (leave empty to run on the offline engine)
ANTHROPIC_API_KEY=

# See .env.example in the repository root for everything else: AI budgets,
# billing (Stripe), error reporting and your company's legal details.
NEXT_TELEMETRY_DISABLED=1
