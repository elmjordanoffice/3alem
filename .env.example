# Aalim settings. Copy to .env for development. In production, set these on your host
# (or in deploy/.env for the Docker Compose setup). docs/deploy.md explains each step.

# ── Required ─────────────────────────────────────────────────────────────────

# Owner connection: used by migrations and trusted system tasks (seeding, platform admin).
DATABASE_URL="postgresql://aalim:aalim@localhost:5432/aalim"
# Runtime connection: a non-owner role. Row-level security is enforced for it.
DATABASE_APP_URL="postgresql://aalim_app:aalim_app@localhost:5432/aalim"

# Better Auth. The secret is 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL for links in emails, webhooks, PDFs and exports (defaults to BETTER_AUTH_URL).
APP_URL=""
# Extra allowed origins, comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Email. Without SMTP_URL, messages are written to .mail/ (development). In production set your
# provider's SMTP URL, e.g. smtps://resend:API_KEY@smtp.resend.com:465, and a verified sender.
# SMTP_URL=""
# MAIL_FROM="Aalim <hello@your-domain.com>"

# Lets a scheduler call POST /api/cron/retention (nightly) and /api/cron/reminders (hourly),
# or run `node scripts/scheduler.mjs`. openssl rand -hex 24
# CRON_SECRET=""

# ── AI ───────────────────────────────────────────────────────────────────────

# With a key, AI generation and scoring are on; without one Aalim runs on its offline engine.
ANTHROPIC_API_KEY=""
# "auto" (default), "anthropic" or "offline".
AI_PROVIDER="auto"
# AALIM_MODEL=""                         # overrides the default model

# Monthly AI spending caps in USD. Past a cap, new work uses the offline engine.
# AI_BUDGET_ORG_MONTHLY_USD="100"        # each organisation (a paid plan sets its own)
# AI_BUDGET_PERSONAL_MONTHLY_USD="200"   # all personal Grow use together
# AI_BUDGET_TOTAL_MONTHLY_USD=""         # optional ceiling for everything

# ── Billing (Stripe). Off, and everything unlimited, until STRIPE_SECRET_KEY is set ──

# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_STARTER_MONTHLY=""
# STRIPE_PRICE_STARTER_YEARLY=""          # optional
# STRIPE_PRICE_GROWTH_MONTHLY=""
# STRIPE_PRICE_GROWTH_YEARLY=""           # optional
# STRIPE_AUTOMATIC_TAX="off"              # "on" once Stripe Tax is set up
# SALES_EMAIL=""                          # Enterprise "Talk to us"

# ── Your company, for the legal and trust pages ─────────────────────────────
# Until LEGAL_ENTITY_NAME is set, /privacy, /terms, /ai and /security show a draft notice.

# LEGAL_ENTITY_NAME=""
# LEGAL_ADDRESS=""
# GOVERNING_LAW=""                        # e.g. "the laws of England and Wales"
# CONTACT_EMAIL=""
# PRIVACY_EMAIL=""
# SECURITY_EMAIL=""
# HOSTING_PROVIDER=""                     # subprocessors listed in the privacy policy
# HOSTING_REGION=""
# DATABASE_PROVIDER=""
# EMAIL_PROVIDER=""

# ── Operations ──────────────────────────────────────────────────────────────

# Error reporting: Sentry, and/or a Slack or Teams incoming webhook for one-line summaries.
# SENTRY_DSN=""
# ERROR_WEBHOOK_URL=""
# Shown in /api/health (Railway and Render are detected automatically).
# APP_VERSION=""

# BullMQ for durable background jobs (then run `npm run worker`).
# REDIS_URL="redis://localhost:6379"
# WORKER_CONCURRENCY="4"

# Browser for PDF export, if not Playwright's own (the Docker image includes one).
# CHROMIUM_PATH=""
# Docker: apply migrations when the container starts.
# MIGRATE_ON_START="1"
# Show the internal component gallery at /design in production.
# DESIGN_GALLERY="off"
# Signs outgoing webhooks to your own systems.
# AALIM_WEBHOOK_SECRET=""

NEXT_TELEMETRY_DISABLED=1
