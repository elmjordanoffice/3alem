# Owner connection: used by migrations and trusted system tasks (seeding, platform admin).
DATABASE_URL="postgresql://aalim:aalim@localhost:5432/aalim"
# Runtime connection: a non-owner role. Row-level security is enforced for it.
DATABASE_APP_URL="postgresql://aalim_app:aalim_app@localhost:5432/aalim"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# AI provider (Phase 1). "anthropic" or "mock".
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

NEXT_TELEMETRY_DISABLED=1
